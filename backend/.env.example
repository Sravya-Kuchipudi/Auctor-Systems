# =============================================================================
# Auctor Systems — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# =============================================================================

# ── LLM Configuration ────────────────────────────────────────────────────────
# Your Google Gemini API key (required for generating websites)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by all 8 Auctor agents (required)
# Configure any valid Gemini model identifier supported by CrewAI/Google, e.g.:
#   GEMINI_MODEL=gemini/gemini-2.5-flash
#   GEMINI_MODEL=gemini/gemini-1.5-pro
#   GEMINI_MODEL=gemini/gemini-1.5-flash
#   GEMINI_MODEL=gemini/gemini-2.0-flash
GEMINI_MODEL=gemini/gemini-2.5-flash

# Temperature for LLM responses (optional, default: 0.7)
GEMINI_TEMPERATURE=0.7

# ── Deployment Configuration ─────────────────────────────────────────────────
# Vercel API token for real deployment (optional)
# If not provided, Auctor will generate deployment config but not deploy.
# Get your token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ── Application Configuration ────────────────────────────────────────────────
# Frontend URL for CORS (optional, default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173
HOST=0.0.0.0
PORT=8000
